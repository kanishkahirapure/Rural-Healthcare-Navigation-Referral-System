# Copy this file to ".env" (cp .env.example .env) and put your own values there.
# The real ".env" file is in .gitignore and must never be committed.

# Password for the MySQL root user. Used by MySQL and by user-service / core-service.
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password

# Secret used to sign login tokens (JWT).
# Must be at least 32 characters long. user-service and core-service read this same value,
# so a token created by one service is accepted by the other.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Optional: Google Gemini API key for AI recommendations.
# Leave it empty to use the built-in keyword fallback.
GEMINI_API_KEY=

# Optional: Gemini model name. gemini-3.8-flash is the default.
GEMINI_MODEL=gemini-3.8-flash
